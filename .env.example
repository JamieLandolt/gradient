# ── Gradient environment template ──────────────────────────────────────────
# Copy to backend/.env (backend vars) and frontend/.env (VITE_ vars).
# NEVER commit real values. The service-role key must never reach the frontend.

# ── Backend (backend/.env) ──────────────────────────────────────────────────
# demo (default): boots without Supabase; supabase: full multi-user mode,
# the SUPABASE_* variables below become mandatory.
APP_MODE=supabase

# Supabase project (Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Optional: only for legacy projects using HS256 JWTs (Settings → API → JWT secret).
# New projects use asymmetric keys discovered via JWKS automatically.
SUPABASE_JWT_SECRET=

# AI provider: mock | openai_compatible (Alibaba Bailian/Qwen) | ollama | anthropic
AI_PROVIDER=mock

# Hosted OpenAI-compatible LLM. Defaults target Alibaba Cloud Bailian (Model
# Studio) — get the key from the Bailian console → API-KEY. Required when
# AI_PROVIDER=openai_compatible; ignored for mock.
DASHSCOPE_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
AI_REQUEST_TIMEOUT_S=30
AI_MAX_RETRIES=1

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── Frontend (frontend/.env) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Tooling (repo root, .env.gitee — gitignored) ────────────────────────────
# GITEE_TOKEN=your-gitee-personal-access-token
