# ── Gradient environment template ──────────────────────────────────────────
# Copy to backend/.env (backend vars) and frontend/.env (VITE_ vars).
# NEVER commit real values. The service-role key must never reach the frontend.

# ── Backend (backend/.env) ──────────────────────────────────────────────────
# Supabase project (Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Optional: only for legacy projects using HS256 JWTs (Settings → API → JWT secret).
# New projects use asymmetric keys discovered via JWKS automatically.
SUPABASE_JWT_SECRET=

# AI provider: mock | ollama | anthropic (only "mock" is implemented in v1)
AI_PROVIDER=mock

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ── Frontend (frontend/.env) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Tooling (repo root, .env.gitee — gitignored) ────────────────────────────
# GITEE_TOKEN=your-gitee-personal-access-token
